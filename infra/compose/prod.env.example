# Template for prod.env, used with compose.prod.example.yaml (docs/operations.md section 5).
# Copy to prod.env next to your compose.yaml, replace EVERY value, and never commit it.
# The API refuses to start while any placeholder below is left in (production guard).
#
# Random values: run this once per secret and paste the output:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep AUTH_SECRET, DATA_ENCRYPTION_KEY and BACKUP_ENCRYPTION_KEY in a password vault as well:
# without them backups cannot be restored or read (operations.md section 1).

# --- Database (passwords: 12+ random characters) -----------------------------------------
POSTGRES_PASSWORD=replace-with-random-password
MIGRATOR_PASSWORD=replace-with-random-password
APP_PASSWORD=replace-with-random-password

# --- Secrets (64+ random characters each, all different) ---------------------------------
AUTH_SECRET=replace-with-64-random-characters
DATA_ENCRYPTION_KEY=replace-with-64-random-characters
BACKUP_ENCRYPTION_KEY=replace-with-64-random-characters

# --- Addresses (https only) ----------------------------------------------------------------
# Where people open the app; companies get <slug>.<PLATFORM_BASE_DOMAIN> (wildcard DNS + TLS).
APP_PUBLIC_URL=https://erp.yourfirm.com
WEB_PUBLIC_URL=https://erp.yourfirm.com
PLATFORM_BASE_DOMAIN=erp.yourfirm.com
# Where browsers download stored files: a host your HTTPS proxy forwards to the object-storage
# service (port 9000), keeping the Host header (signed links include it).
S3_PUBLIC_ENDPOINT=https://files.erp.yourfirm.com

# --- Mail ----------------------------------------------------------------------------------
SMTP_HOST=smtp.yourfirm.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ultimate ERP <erp@yourfirm.com>

# --- Object storage credentials ------------------------------------------------------------
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret

# --- Proxies -------------------------------------------------------------------------------
# Reverse proxies in front of the API that append X-Forwarded-For: the web container (1) plus
# your HTTPS proxy (2). Check: the audit log must show people's real IP addresses.
TRUST_PROXY_HOPS=2

# --- Optional ------------------------------------------------------------------------------
# Error reports (Sentry protocol, e.g. self-hosted GlitchTip). Empty = nothing is sent.
SENTRY_DSN=