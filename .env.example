# Local development settings. `pnpm env:init` copies this file to `.env` (git-ignored).
# These are throwaway local-only credentials. Never put real secrets in this file.

# --- API -------------------------------------------------------------------
NODE_ENV=development
# dev | saas | onprem
APP_PROFILE=dev
API_HOST=127.0.0.1
API_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs in the terminal. Must be false in production.
LOG_PRETTY=true
# Comma-separated browser origins allowed to call the API (empty = none).
CORS_ORIGINS=http://localhost:5173
# Accept X-Request-Id from callers. Only enable behind a trusted reverse proxy.
TRUST_INCOMING_REQUEST_ID=false
HTTP_BODY_LIMIT=1mb
# The API connects as erp_app: no superuser, no BYPASSRLS, row-level security applies (ADR-0003).
DATABASE_URL=postgres://erp_app:local-dev-app-password@127.0.0.1:5432/erp
# Owns the tables and runs migrations (pnpm db:migrate).
DATABASE_MIGRATOR_URL=postgres://erp_migrator:local-dev-migrator-password@127.0.0.1:5432/erp
# Development only: Postgres superuser, used by pnpm db:bootstrap to create the roles above.
DATABASE_ADMIN_URL=postgres://erp_dev:local-dev-only@127.0.0.1:5432/erp
DB_POOL_MAX=10

# --- Identity (Milestone 1.3a) --------------------------------------------
# Signs cookies and encrypts two-factor secrets. Local placeholder only: production uses a
# random value of at least 32 characters from a secret manager, never this one.
AUTH_SECRET=local-dev-only-auth-secret-change-me-0123456789
# Public base URL of the API.
APP_PUBLIC_URL=http://localhost:3000
# Public base URL of the web app (email links, company addresses <slug>.<domain>).
WEB_PUBLIC_URL=http://localhost:5173
SMTP_HOST=127.0.0.1
SMTP_FROM=Ultimate ERP <no-reply@localhost>
# Leaked-password check (Have I Been Pwned). Set false for installs without internet access.
PASSWORD_BREACH_CHECK=true

# --- Docker Compose services (infra/compose/compose.dev.yaml) --------------
POSTGRES_USER=erp_dev
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=erp
POSTGRES_PORT=5432

# S3-compatible object storage (RustFS). Console: http://localhost:9001
S3_ACCESS_KEY=erp-dev-access
S3_SECRET_KEY=local-dev-only-secret
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Mailpit fake inbox. Web UI: http://localhost:8025
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
