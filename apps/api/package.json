{
  "name": "@ultimate-erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently --kill-others --names tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@ultimate-erp/contracts": "workspace:*",
    "@ultimate-erp/db": "workspace:*",
    "@ultimate-erp/i18n": "workspace:*",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.1",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@ultimate-erp/config": "workspace:*",
    "concurrently": "10.0.6",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
